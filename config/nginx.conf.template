# =====================================================================
#  智美成ERP系统 (portable / green edition) - nginx configuration template
#  bin/start.ps1 replaces the placeholders with real local values.
#  Everything lives inside the project runtime folder:
#  no registry, no Windows service, nothing written outside the project.
# =====================================================================

worker_processes  4;
error_log  logs/error.log  warn;
pid        logs/nginx.pid;

events {
    worker_connections  2048;
    multi_accept on;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    access_log    logs/access.log;
    client_body_temp_path temp/client_body;
    proxy_temp_path       temp/proxy;
    fastcgi_temp_path     temp/fastcgi;
    uwsgi_temp_path       temp/uwsgi;
    scgi_temp_path        temp/scgi;

    sendfile        on;
    tcp_nopush      on;
    keepalive_timeout  65;
    client_max_body_size 32m;
    server_tokens   off;
    charset         utf-8;

    # FastCGI pool: one php-cgi process per port, nginx round-robins.
    # 每个进程都带 max_fails=0:某个 php-cgi 偶发退出时不要把它永久踢出池,
    # 配合下面的 fastcgi_next_upstream 自动换下一个进程重试。
    upstream erp_php {
__FCGI_UPSTREAM__
    }

    server {
        listen       __PORT__;
        server_name  localhost;

        root         __ROOT__/public;
        index        index.php index.html;

        # static assets served directly
        location ~* \.(css|js|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|map)$ {
            expires 7d;
            access_log off;
        }

        # everything else goes to the front controller
        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        # PHP handling.
        # IMPORTANT: once fastcgi_param appears in a location block, nginx no
        # longer inherits the parent level parameters, so the full standard
        # set must be listed here. Missing REQUEST_URI / REQUEST_METHOD
        # breaks routing (302 redirect loop, POST handled as GET).
        location ~ \.php$ {
            fastcgi_pass   erp_php;
            fastcgi_index  index.php;

            fastcgi_param  QUERY_STRING       $query_string;
            fastcgi_param  REQUEST_METHOD     $request_method;
            fastcgi_param  CONTENT_TYPE       $content_type;
            fastcgi_param  CONTENT_LENGTH     $content_length;
            fastcgi_param  SCRIPT_NAME        $fastcgi_script_name;
            fastcgi_param  SCRIPT_FILENAME    $document_root$fastcgi_script_name;
            fastcgi_param  REQUEST_URI        $request_uri;
            fastcgi_param  DOCUMENT_URI       $document_uri;
            fastcgi_param  DOCUMENT_ROOT      $document_root;
            fastcgi_param  SERVER_PROTOCOL    $server_protocol;
            fastcgi_param  REQUEST_SCHEME     $scheme;
            fastcgi_param  GATEWAY_INTERFACE  CGI/1.1;
            fastcgi_param  SERVER_SOFTWARE    nginx/$nginx_version;
            fastcgi_param  REMOTE_ADDR        $remote_addr;
            fastcgi_param  REMOTE_PORT        $remote_port;
            fastcgi_param  SERVER_ADDR        $server_addr;
            fastcgi_param  SERVER_PORT        $server_port;
            fastcgi_param  SERVER_NAME        $server_name;
            fastcgi_param  REDIRECT_STATUS    200;

            fastcgi_read_timeout 300;
            fastcgi_buffers 16 32k;
            fastcgi_buffer_size 64k;
            fastcgi_busy_buffers_size 64k;

            # 某个 php-cgi 进程意外退出 / 连接失败时,自动换下一个进程重试,
            # 而不是直接给用户 502。
            # 注意:不重试 http_500 —— 应用自身的 500 不应重试;
            #       非幂等请求(POST)在上游已收到请求后也不会被重放,不会重复提交。
            fastcgi_next_upstream error timeout invalid_header;
            fastcgi_next_upstream_tries 8;
            fastcgi_next_upstream_timeout 15s;
        }

        # deny dot files
        location ~ /\. {
            deny all;
        }
    }
}
